{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/slapstick-scenario.schema.json",
  "title": "Slap Stick test scenario",
  "type": "object",
  "additionalProperties": false,
  "required": ["name"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "name": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "description": { "type": "string" },
    "checkpoint": { "type": "string", "minLength": 1 },
    "catalog": { "type": "string", "minLength": 1 },
    "rom": { "type": "string", "minLength": 1 },
    "money": {
      "oneOf": [
        { "type": "integer", "minimum": 0, "maximum": 99999 },
        { "type": "string", "pattern": "^[0-9]{1,5}$" }
      ]
    },
    "map": { "$ref": "#/$defs/reference" },
    "room": { "$ref": "#/$defs/reference" },
    "direction": { "$ref": "#/$defs/direction" },
    "entry": {
      "oneOf": [
        { "const": "field" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": { "const": "field" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "encounter"],
          "properties": {
            "type": { "const": "battle" },
            "encounter": { "$ref": "#/$defs/reference" },
            "ready": { "enum": ["loaded", "command"] },
            "settleFrames": { "type": "integer", "minimum": 0, "maximum": 60000 },
            "timeoutFrames": { "type": "integer", "minimum": 1, "maximum": 60000 }
          }
        }
      ]
    },
    "position": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y"],
      "properties": {
        "x": { "$ref": "#/$defs/integerReference" },
        "y": { "$ref": "#/$defs/integerReference" },
        "direction": { "$ref": "#/$defs/direction" }
      }
    },
    "flags": {
      "type": "object",
      "additionalProperties": { "type": "boolean" }
    },
    "inventory": {
      "oneOf": [
        { "$ref": "#/$defs/itemList" },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "enum": ["replace", "merge"] },
            "items": { "$ref": "#/$defs/itemList" },
            "equipped": {
              "oneOf": [
                { "$ref": "#/$defs/item" },
                { "type": "null" }
              ]
            }
          }
        }
      ]
    },
    "player": {
      "type": "object",
      "additionalProperties": false,
      "anyOf": [
        { "required": ["name"] },
        { "required": ["level"] }
      ],
      "properties": {
        "name": { "type": "string", "pattern": "^[A-Za-z]{1,5}$" },
        "level": { "type": "integer", "minimum": 1, "maximum": 99 }
      }
    },
    "party": {
      "oneOf": [
        {
          "type": "array",
          "maxItems": 2,
          "items": { "$ref": "#/$defs/reference" }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "members": {
              "type": "array",
              "maxItems": 2,
              "items": { "$ref": "#/$defs/reference" }
            },
            "robots": { "$ref": "#/$defs/robots" },
            "robotsAvailable": { "$ref": "#/$defs/robots" },
            "active": { "type": "integer", "minimum": 1, "maximum": 3 },
            "activeRobot": { "type": "integer", "minimum": 1, "maximum": 3 },
            "order": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "uniqueItems": true,
              "items": { "type": "integer", "minimum": 1, "maximum": 3 }
            }
          }
        }
      ]
    },
    "launch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "ready": { "enum": ["map", "field"] },
        "settleFrames": { "type": "integer", "minimum": 0, "maximum": 60000 },
        "timeoutFrames": { "type": "integer", "minimum": 1, "maximum": 60000 }
      }
    },
    "interaction": {
      "oneOf": [
        { "$ref": "#/$defs/button" },
        { "const": false },
        { "type": "null" },
        { "$ref": "#/$defs/inputStep" }
      ]
    },
    "steps": {
      "type": "array",
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/button" },
          { "$ref": "#/$defs/inputStep" },
          {
            "type": "object",
            "additionalProperties": false,
            "required": ["waitFrames"],
            "properties": {
              "waitFrames": { "type": "integer", "minimum": 1, "maximum": 60000 }
            }
          }
        ]
      }
    },
    "wram": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["address", "value"],
        "properties": {
          "address": { "$ref": "#/$defs/wramAddress" },
          "width": { "enum": [1, 2] },
          "value": { "$ref": "#/$defs/integerReference" }
        }
      }
    }
  },
  "$defs": {
    "reference": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "integer", "minimum": 0, "maximum": 65535 },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": { "id": { "$ref": "#/$defs/integerReference" } }
        }
      ]
    },
    "integerReference": {
      "oneOf": [
        { "type": "integer", "minimum": 0, "maximum": 65535 },
        { "type": "string", "pattern": "^(?:[0-9]+|0[xX][0-9A-Fa-f]+|\\$[0-9A-Fa-f]+)$" }
      ]
    },
    "direction": {
      "oneOf": [
        { "enum": ["down", "up", "left", "right"] },
        { "type": "integer", "minimum": 0, "maximum": 3 }
      ]
    },
    "button": {
      "enum": ["a", "b", "x", "y", "l", "r", "start", "select", "up", "down", "left", "right"]
    },
    "inputStep": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "button": { "$ref": "#/$defs/button" },
        "delayFrames": { "type": "integer", "minimum": 0, "maximum": 60000 },
        "holdFrames": { "type": "integer", "minimum": 1, "maximum": 60000 },
        "afterFrames": { "type": "integer", "minimum": 0, "maximum": 60000 }
      }
    },
    "wramAddress": {
      "oneOf": [
        { "type": "integer", "minimum": 0, "maximum": 131071 },
        { "type": "string", "pattern": "^(?:[0-9]+|0[xX][0-9A-Fa-f]+|\\$[0-9A-Fa-f]+)$" }
      ]
    },
    "itemList": {
      "type": "array",
      "items": { "$ref": "#/$defs/item" }
    },
    "item": {
      "oneOf": [
        { "type": "string", "minLength": 1 },
        { "type": "integer", "minimum": 0, "maximum": 65535 },
        {
          "type": "object",
          "additionalProperties": false,
          "oneOf": [
            { "required": ["item"] },
            { "required": ["id"] },
            { "required": ["raw"] }
          ],
          "allOf": [
            {
              "if": { "required": ["raw"] },
              "then": { "not": { "required": ["level"] } }
            }
          ],
          "properties": {
            "item": { "$ref": "#/$defs/reference" },
            "id": { "$ref": "#/$defs/integerReference" },
            "raw": { "$ref": "#/$defs/integerReference" },
            "level": { "type": "integer", "minimum": 0, "maximum": 255 },
            "quantity": { "type": "integer", "minimum": 1, "maximum": 70 }
          }
        }
      ]
    },
    "robots": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "integer", "minimum": 1, "maximum": 3 }
    }
  }
}
